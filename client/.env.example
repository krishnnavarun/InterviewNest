# Copy to .env.local for local development.

# API base URL (defaults: http://localhost:5000/api in dev, the Vercel server in production)
# VITE_API_URL=http://localhost:5000/api

# Google OAuth "Web application" client id. When empty, the Google button is hidden.
# Add http://localhost:5173 and your production URL as Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
