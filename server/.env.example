# Copy to .env and fill in real values. Never commit .env.

# Required
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/interviewnest
JWT_SECRET=replace-with-a-long-random-string
GEMINI_API_KEY=

# Optional: voice features (disabled when missing)
ASSEMBLYAI_API_KEY=
MURF_API_KEY=

# Optional: Google sign-in (same OAuth client id as VITE_GOOGLE_CLIENT_ID in client/.env)
GOOGLE_CLIENT_ID=

# Optional overrides
# PORT=5000
# MONGODB_DB_NAME=interviewnest
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.7-flash,gemini-3.5-flash-lite,gemini-3.5-flash
# ASSEMBLYAI_SPEECH_MODELS=universal-2
# MURF_VOICE_ID=en-US-natalie
# CLIENT_ORIGINS=http://localhost:5173,https://interview-nest-two.vercel.app
# DAILY_INTERVIEW_LIMIT=10
# DAILY_AI_CALL_LIMIT=400
